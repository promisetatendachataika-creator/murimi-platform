# Copy these into your hosting platform's environment settings for the live site.
# On your own laptop you don't need any of them.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=paste-a-long-random-string-here
DJANGO_ALLOWED_HOSTS=murimi.co.zw,www.murimi.co.zw
DJANGO_CSRF_TRUSTED_ORIGINS=https://murimi.co.zw,https://www.murimi.co.zw
POSTGRES_DB=murimi
POSTGRES_USER=murimi
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# WhatsApp codes. Leave MURIMI_CODE_SENDER=console to test for free (codes print in the server window).
MURIMI_CODE_SENDER=whatsapp
WHATSAPP_TOKEN=paste-your-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=paste-the-phone-number-id
WHATSAPP_TEMPLATE=murimi_code
WHATSAPP_TEMPLATE_LANG=en
